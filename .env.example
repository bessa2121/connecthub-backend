# Porta HTTP (Render/Railway definem automaticamente)
PORT=3000
# Segredo para assinar tokens de login. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=troque-por-uma-string-longa-e-aleatoria
# String de conexão PostgreSQL (Neon, Supabase, etc.). Vazio = memória (dados somem ao reiniciar).
DATABASE_URL=
# Origens (sites) autorizadas a chamar a API, separadas por vírgula. Ex.: https://connecthub.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
# Cria projetos e alunos de demonstração se o banco estiver vazio (true/false)
SEED_DEMO=true

# --- Cadastro por autorização / e-mail transacional (Resend: https://resend.com) ---
# Sem estas duas variáveis o cadastro de novos alunos FICA INDISPONÍVEL (503): a API nunca finge que enviou o e-mail.
# EMAIL_FROM precisa ser de um domínio verificado no Resend (ex.: "ConnectHub <nao-responda@seudominio.com.br>").
RESEND_API_KEY=
EMAIL_FROM=
# Dias que solicitações rejeitadas/revogadas ficam guardadas antes de serem apagadas (LGPD).
RETENTION_DAYS=90
